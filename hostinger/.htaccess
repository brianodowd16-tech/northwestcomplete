Options -Indexes
DirectoryIndex index.php index.html

# Settings and shared code are only ever included by the other PHP files.
<FilesMatch "^(config|config\.sample|lib)\.php$|\.md$">
  Require all denied
</FilesMatch>

# Pages and draw settings are always checked for updates; scripts and styles carry a version stamp.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
