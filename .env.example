DATABASE_URL=postgres://round:round@localhost:5432/round
# Public URL of the app (production: https://complete.pub). Used for payment return/notify URLs, the Xero redirect and QR codes.
APP_URL=http://localhost:3000
# Signs session cookies. Use a long random string.
SESSION_SECRET=change-me
# Encrypts each venue's payment keys and Xero tokens: 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Xero app (developer.xero.com). Redirect URI: {APP_URL}/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Sage Accounting (developerselfservice.sageone.com), callback {APP_URL}/api/sage/callback
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
# Optional override of the requested Xero scopes.
XERO_SCOPES=
# Revolut checkout widget mode for venues on Revolut: sandbox or prod.
REVOLUT_MODE=sandbox
# Optional: turns on "Ask your data" in the back office (Claude). Never sent guest personal data.
ANTHROPIC_API_KEY=
# Outgoing email (business sign-up codes) through the Hostinger mailbox. Keep the password in the host's secret store.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@complete.pub
SMTP_PASS=
MAIL_FROM=Complete <hello@complete.pub>
# Web Push ("your drinks are ready"). Generate once: npx web-push generate-vapid-keys. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@complete.pub
# Partners: lending partner sign-up link, and API keys for drinks-brand insights (comma-separated, 24+ characters each).
FUNDING_PARTNER_URL=
BRAND_API_TOKENS=
# Optional paid TheSportsDB key for full fixture lists.
SPORTSDB_KEY=
# Guest sign-in texts (Twilio). Use a Messaging Service SID, or a From number / alphanumeric sender ("Complete").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=Complete

# Operator console at /ops (HTTP Basic). Leave unset to disable it.
OPS_USER=
OPS_PASSWORD=
# Monthly invoices to venues
BILLING_EMAIL=
BILLING_PAY_INSTRUCTIONS=
SUPPORT_EMAIL=
# Social posting: Meta app (Facebook Pages + Instagram) and Google (Business Profile)
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Complete's own network accounts for county round-ups (optional)
NETWORK_META_PAGE_ID=
NETWORK_META_PAGE_TOKEN=
NETWORK_IG_USER_ID=
NETWORK_AUTOPUBLISH=
