# Public URL of the site (used for Stripe redirect URLs and metadata)
NEXT_PUBLIC_SITE_URL=https://northwestboatmaintenance.com

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the webhook endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email delivery for enquiries and order notifications (https://resend.com)
# If unset, enquiries are logged to the server console instead.
RESEND_API_KEY=
# Address that receives enquiries / order notifications
NOTIFY_EMAIL=brian@northwestboatmaintenance.com
# Verified sender address in Resend
FROM_EMAIL="Northwest Boat Maintenance <noreply@northwestboatmaintenance.com>"
