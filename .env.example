# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Public address of this storefront (used for myPOS return/callback URLs; must be https in production).
SITE_URL=https://odowdscarrick.com

# Where WordPress/WooCommerce lives. Keep as-is until the DNS cutover, then
# change to the WordPress subdomain, e.g. https://admin.odowdscarrick.com
WC_URL=https://odowdscarrick.com

# WooCommerce → Settings → Advanced → REST API → Add key (Read/Write).
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Secret you type into WooCommerce → Settings → Advanced → Webhooks (any long random string).
WC_WEBHOOK_SECRET=

# "sandbox" (default, public myPOS test account, no real money) or "live".
MYPOS_MODE=sandbox

# Live only: paste the base64 "configuration pack" from your myPOS account
# (Online → Online stores → your store → Keys / configuration pack)...
MYPOS_CONFIG_PACK=
# ...or set the values individually (they override the pack):
# MYPOS_SID=
# MYPOS_WALLET_NUMBER=
# MYPOS_KEY_INDEX=
# MYPOS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# MYPOS_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
