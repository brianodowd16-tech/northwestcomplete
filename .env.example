# Public https URL of the site. myPOS redirects customers and posts payment
# confirmations to this address, so it must be the live (or tunnelled) https URL.
NEXT_PUBLIC_SITE_URL=https://northwestboatmaintenance.com

# myPOS Checkout — myPOS account → Online → (your store) → Integration / Configuration package.
# Store ID (SID), wallet (client) number and the key index of the key pair you uploaded.
MYPOS_SID=
MYPOS_WALLET_NUMBER=
MYPOS_KEY_INDEX=1
# Your store private key (PEM). Newlines may be written as \n on one line.
MYPOS_PRIVATE_KEY=
# The myPOS public certificate (PEM) used to check payment confirmations.
MYPOS_PUBLIC_CERT=
# "true" sends customers to the myPOS sandbox (test cards, no real money).
MYPOS_SANDBOX=true

# Email delivery for enquiries and order notifications (https://resend.com)
# If unset, emails are logged to the server console instead.
RESEND_API_KEY=
# Address that receives enquiries and order notifications
NOTIFY_EMAIL=brian@northwestboatmaintenance.com
# Verified sender address in Resend
FROM_EMAIL="Northwest Boat Maintenance <noreply@northwestboatmaintenance.com>"
