# Stripe — use sk_test_... keys until you're ready to go live
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhook` locally, or the Dashboard webhook endpoint in production
STRIPE_WEBHOOK_SECRET=

# Public URL of the site (no trailing slash), used for Stripe redirect URLs
PUBLIC_URL=http://localhost:3000
PORT=3000

# Protects /api/admin/* (ticket export for the draw). Use a long random string.
ADMIN_TOKEN=

# Where orders are stored (JSON file). Point at a persistent volume in production.
DATA_FILE=./data/orders.json
